# Copy to ../.env and fill in values.  Anything left blank means the
# corresponding adapter falls back to mock.

# ---- LLM providers ----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

DEEPSEEK_API_KEY=

# ---- Sports data sources ----------------------------------------------------
AEGEANBENCH_FOOTBALL_DATA_KEY=       # free: football-data.org/client/register
AEGEANBENCH_SOCCERSAPI_KEY=          # paid: soccersapi.com
OPENWEATHER_API_KEY=                 # free tier: openweathermap.org
FBREF_LIVE=0                         # set to 1 to enable fbref.com scraping

# ---- Service URLs -----------------------------------------------------------
AEGEAN_CONSENSUS_URL=http://aegean-consensus:8000
CHAT_SERVICE_URL=http://chat-service:9100

# ---- Optional knobs ---------------------------------------------------------
OCCULT_LIVE_HOROSCOPE=0              # 1 to call aztro for real horoscopes
